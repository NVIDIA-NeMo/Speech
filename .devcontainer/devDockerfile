ARG NEMO_VERSION=25.11

FROM nvcr.io/nvidia/nemo:${NEMO_VERSION}

LABEL \
    maintainer="NeMoTTS team" \
    description="NeMoTTS Dev Container"

WORKDIR /workspace/NeMo

USER root

# Claude Code state (auth, settings, per-project memory) lives here; devcontainer.json
# mounts a named volume over it so it survives container rebuilds.
RUN mkdir -p /root/.claude
