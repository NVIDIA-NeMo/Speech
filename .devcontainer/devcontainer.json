{
  "name": "NeMoTTS Dev Container",
  "build": {
    "dockerfile": "../.devcontainer/devDockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "Nsight JupyterLab",
      "onAutoForward": "notify"
    }
  },
  "runArgs": [
    "--gpus",
    "\"device=0,1\"",
    "--ipc=host",
    "--name",
    "${localEnv:USER}_nemo_tts_devcontainer_nemotts-114"
  ],
  "workspaceFolder": "/workspace/NeMo",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace/NeMo,type=bind"
  ],
  "remoteUser": "root",
  "postCreateCommand": "pip install -e /workspace/NeMo --no-deps && pip install lhotse==2.0.0a1",
  "customizations": {
    "vscode": {
        "settings": {
            "terminal.integrated.shell.linux": "/bin/bash"
        },
        "extensions": [
          "openai.chatgpt",
          "ms-python.python",
          "ms-toolsai.jupyter"
        ]
    }
  }
}
