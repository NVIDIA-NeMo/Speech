# This Dockerfile installs the necessary dependencies for streaming speech translation with vLLM.
#
# CUDA driver requirement: the image ships CUDA 13.2 and the cu130 PyTorch build, so the host NVIDIA driver must
# support CUDA 13 (R580 or newer). On an older driver (for example R560, CUDA 12.6) the image builds and imports,
# but the first CUDA call fails with "The NVIDIA driver on your system is too old". Check with `nvidia-smi`:
# its "CUDA Version" field must be 13.0 or higher. Run the container with `docker run --gpus all`.

ARG BASE_IMAGE=nvcr.io/nvidia/cuda-dl-base:26.04-cuda13.2-devel-ubuntu24.04

FROM ${BASE_IMAGE}

ARG GIT_URL="https://github.com/NVIDIA-NeMo/Speech.git"
ARG CHECKOUT="main"
ARG UV_VERSION=0.13.7
ARG PYTHON_VERSION=3.12

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && \
  apt-get upgrade -y && \
  apt-get install -y \
  libtool libltdl-dev \
  libsndfile1 sox \
  libfreetype6 \
  libsox-fmt-all \
  swig \
  ffmpeg \
  libavdevice-dev \
  git \
  curl \
  build-essential \
  python3-dev \
  cmake && \
  rm -rf /var/lib/apt/lists/*

# Keep only the cuDNN wheel PyTorch uses: the base image's apt cuDNN has a different version and gets mixed in
# when cuDNN dlopens sublibraries the wheel lacks (CUDNN_STATUS_SUBLIBRARY_VERSION_MISMATCH).
# Same cleanup as docker/Dockerfile; a no-op for bases without apt cuDNN.
RUN <<"EOF" bash -euxo pipefail
cudnn_packages="$(dpkg-query -W -f='${db:Status-Status} ${Package}\n' | awk '$1 == "installed" && $2 ~ /^libcudnn/ {print $2}')"
[[ -z "${cudnn_packages}" ]] || apt-get purge -y ${cudnn_packages}
ldconfig
! ldconfig -p | grep libcudnn
EOF

# NeMo requires Python >= 3.12; uv provisions it and the environment.
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | env UV_INSTALL_DIR=/usr/local/bin sh

# Install NeMo with the ASR and vLLM extras. The vllm extra owns its own Torch/CUDA stack
# and conflicts with the `all`, `cu*` and `compiled*` extras, so it is installed on its own.
RUN git clone --recursive ${GIT_URL} /nemo_dir && cd /nemo_dir && \
  git checkout ${CHECKOUT} && \
  uv sync --locked --python ${PYTHON_VERSION} --extra asr --extra vllm

ENV PATH="/nemo_dir/.venv/bin:${PATH}"
WORKDIR /nemo_dir
